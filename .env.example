ENVIRONMENT=local
LOG_LEVEL=INFO

# Секрет для подписи JWT. В проде - из секрет-хранилища, не из файла.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<твой секрет>

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

POSTGRES_TEST_DB=ecommerce_test
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0

# Отдавать ли refresh-токен в теле ответа вдобавок к httpOnly-cookie.
# true - удобно для Postman и мобильных клиентов, false - строгий браузерный режим.
AUTH_REFRESH_IN_BODY=false
# Флаг Secure у refresh-cookie. false допустим только для локального http.
AUTH_COOKIE_SECURE=true
# Ограничение частоты запросов к /auth/*. Выключать только для отладки.
RATE_LIMIT_ENABLED=true

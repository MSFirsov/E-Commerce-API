# Служебные директории git и IDE
.git
.gitignore
.idea
.vscode

# Локальное виртуальное окружение.
# Критично: оно собрано под macOS, в Linux-образе просто не заработает.
.venv

# Кэши Python и инструментов
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Секреты. В образ попадать не должны никогда: образ уедет в реестр,
# а переменные окружения передаются при запуске, а не зашиваются при сборке.
.env

# Тесты и инфраструктура - в рантайме не нужны
tests
Makefile
docker-compose.yaml
Dockerfile

# Рабочие заметки
notes

# Прочее
.DS_Store
